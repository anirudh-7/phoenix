# Copy to .env and fill in. Never commit .env.

# Postgres
DATABASE_URL=postgresql+asyncpg://phoenix:phoenix@localhost:5432/phoenix
# For Alembic (sync driver)
DATABASE_URL_SYNC=postgresql+psycopg://phoenix:phoenix@localhost:5432/phoenix

# Application secret key for column-level crypto (OAuth tokens).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PHOENIX_APP_KEY=replace-me

# Gmail OAuth (fill in after you create a Google Cloud project)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/oauth/gmail/callback

# Zerodha Kite Connect (fill in after subscribing)
KITE_API_KEY=
KITE_API_SECRET=

# Claude Agent SDK — uses your Claude Code / Max credentials; no API key needed here.
# If you want to force a specific model for agents, set this:
PHOENIX_DEFAULT_MODEL=claude-sonnet-4-6

# Logging
LOG_LEVEL=INFO
